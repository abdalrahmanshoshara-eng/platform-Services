# ---- PostgreSQL ----
POSTGRES_DB=reports_db
POSTGRES_USER=reports_user
POSTGRES_PASSWORD=reports_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Optional single-URL form; if set it overrides the POSTGRES_* values above.
# DATABASE_URL=postgres://reports_user:reports_password@db:5432/reports_db
DJANGO_DB_CONN_MAX_AGE=60

# ---- Redis (used by Celery in Phase 4+) ----
REDIS_URL=redis://redis:6379/0

# ---- Django ----
DJANGO_SECRET_KEY=local-dev-only-change-this-64-character-signing-key-before-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Storage/config timezone (UTC recommended); report display timezone is separate.
DJANGO_TIME_ZONE=UTC
REPORT_DISPLAY_TIMEZONE=Asia/Damascus

# ---- Local seed accounts (created idempotently by Docker setup) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
NORMAL_USERNAME=user
NORMAL_EMAIL=user@example.com
NORMAL_PASSWORD=user123456

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ---- External services ----
CARDNEST_URL=https://cardnest.moid.gov.sy/login
